# CONFIG_SIGALG_RSAPSS is not set
CONFIG_SIGALG_CMS=y
CONFIG_PKCS11=y
CONFIG_ENCRYPTED_IMAGES=y
CONFIG_ENCRYPTED_IMAGES_HARDEN_LOGGING=y
CONFIG_GUNZIP=y
CONFIG_LIBCONFIG=y
CONFIG_BOOTLOADERHANDLER=y
CONFIG_RAW=y
