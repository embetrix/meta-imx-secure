set -eu
set -f

fail() {
    echo "Update check failed: $*" >&2
    exit 1
}

upgrade_available=$(fw_printenv -n upgrade_available) \
    || fail "cannot read pending update state"
if [ "$upgrade_available" != "1" ]; then
    rollback_slot=$(fw_printenv -n rollback_slot) \
        || fail "cannot read rollback slot"
    case "$rollback_slot" in
        "") ;;
        a|b)
            ustate=$(fw_printenv -n ustate) || fail "cannot read update result"
            if [ "$upgrade_available" = "0" ] && [ "$ustate" = "3" ]; then
                echo "######################################################"
                echo "Update failed: rolled back to boot slot $rollback_slot"
                echo "######################################################"
            fi
            ;;
        *) fail "invalid rollback slot: $rollback_slot" ;;
    esac
    exit 0
fi

bootargs=$(tr '\000' ' ' < /sys/firmware/devicetree/base/chosen/bootargs) \
    || fail "cannot read device tree bootargs"
boot_slot=""
for arg in $bootargs; do
    case "$arg" in
        boot_slot=*) boot_slot=${arg#boot_slot=} ;;
    esac
done
case "$boot_slot" in
    a|b) ;;
    *) fail "missing or invalid boot_slot in device tree bootargs" ;;
esac

check_slot() {
    fw_boot_slot=$(fw_printenv -n boot_slot) \
        || fail "cannot read firmware boot slot"
    [ "$boot_slot" = "$fw_boot_slot" ] \
        || fail "boot slot mismatch: dt=$boot_slot fwenv=$fw_boot_slot"
}

check_slot

case "${REQUIRED_SERVICES-all}" in
    all)
        failed_services=$(systemctl list-units --type=service --state=failed --no-legend --plain --no-pager) \
            || fail "cannot check service states"
        [ -z "$failed_services" ] || fail "failed services:
$failed_services"
        ;;
    *)
        for service in ${REQUIRED_SERVICES-all}; do
            systemctl is-active --quiet "$service" \
                || fail "required service is not active: $service"
        done
        ;;
esac

if [ -n "${HEALTH_CHECK:-}" ]; then
    /bin/sh -c "$HEALTH_CHECK" || fail "application health check failed"
fi

# Recheck after the health check in case another update has started
check_slot
upgrade_available=$(fw_printenv -n upgrade_available) \
    || fail "cannot reread pending update state"
[ "$upgrade_available" = "1" ] || exit 0

fw_setenv -s - <<'EOF' || fail "cannot confirm update"
upgrade_available=0
bootcount=0
ustate=0
EOF

echo "########################################"
echo "Update confirmed on boot slot $boot_slot"
echo "########################################"
