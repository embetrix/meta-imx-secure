From 70c915a43a09ac5bac0fc22dff7213e2b5c1cb4c Mon Sep 17 00:00:00 2001
From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Date: Thu, 22 Oct 2026 15:03:28 +0200
Subject: [PATCH] imx91: frdm: apply configured FIT boot settings

Keep MMC environment loading and board setup enabled. Apply the configured
boot command and load address after loading the saved environment so old
values do not select the AHAB OS-container path. Other saved settings stay
unchanged.

Upstream-Status: Inappropriate [layer boot policy]
Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
 board/nxp/imx91_frdm/imx91_frdm.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/board/nxp/imx91_frdm/imx91_frdm.c b/board/nxp/imx91_frdm/imx91_frdm.c
index b9dbd0e..75fcfcb 100644
--- a/board/nxp/imx91_frdm/imx91_frdm.c
+++ b/board/nxp/imx91_frdm/imx91_frdm.c
@@ -351,6 +351,10 @@ int board_late_init(void)
 	env_set("sec_boot", "yes");
 #endif
 
+	/* Apply the configured FIT boot settings after loading the environment */
+	env_set("bootcmd", CONFIG_BOOTCOMMAND);
+	env_set_hex("loadaddr", CONFIG_SYS_LOAD_ADDR);
+
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
 	env_set("board_name", "11X11_FRDM");
 	env_set("board_rev", "iMX91");
-- 
2.53.0

