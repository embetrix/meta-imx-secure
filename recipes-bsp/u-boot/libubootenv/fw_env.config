# SPDX-License-Identifier: MIT
# fwenv storage in the gap between GPT and imx-boot
# /dev/bootdev is created by initramfs for the selected boot disk
# Separate from U-Boot's environment which are disabled in prod
# Device        Offset    Env size
/dev/bootdev    0x5000    0x1800
/dev/bootdev    0x6800    0x1800
