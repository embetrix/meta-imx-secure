 click-option-group<1,>=0.3.0
 click!=8.1.4,!=8.3,<9,>=7.1
@@ -13,10 +13,8 @@
 fastjsonschema<3,>=2.15.1
 filelock<4,>=3
 hexdump<4
-importlib-metadata<9
+importlib-metadata<10
 libusbsio<3,>=2.2.1
-libuuu<2,>=1.5.239
-oscrypto<2
 packaging<27,>=23.2
 platformdirs<4.12,>=3.9.1 # 4.12 changed private API used by SPSDKPlatformDirs
 prettytable<4,>=3.12
@@ -24,11 +22,8 @@
 pyserial<4,>=3.1
 requests<3,>=2.32.3
 ruamel.yaml<1,>=0.17
-ruamel.yaml.clib!=0.2.13,!=0.2.15,<1  # 0.2.13: missing header files for build, 0.2.15: Black Duck detection issues
 setuptools_scm<10
 setuptools<84,>=83.0.0  # >=83.0.0: fix MANIFEST.in exclusion bypass via Unicode NFC/NFD collision (GHSA / VU#604762)
 sly<1
-spsdk-mcu-link<1,>=0.6.11
-spsdk-pyocd<1,>=0.2.0
