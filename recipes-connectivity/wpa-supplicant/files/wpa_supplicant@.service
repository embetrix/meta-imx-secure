[Unit]
Description=WPA supplicant daemon (interface-specific version)
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -c /etc/wpa_supplicant/wpa_supplicant-%I.conf -i %I

[Install]
WantedBy=multi-user.target
